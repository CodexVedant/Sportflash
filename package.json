{
    "name": "sportflash-root",
    "version": "1.0.0",
    "scripts": {
        "install-all": "npm install && cd Sportflash-backend && npm install && cd ../Sportflash-app && npm install",
        "start:backend": "cd Sportflash-backend && npm run dev",
        "start:frontend": "cd Sportflash-app && npm start",
        "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}